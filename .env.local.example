# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

# Safe to expose to the browser — this is the public anon key, protected by
# the Row Level Security policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER expose this to the browser. Server-only — used exclusively by
# app/api/delete-account/route.ts to actually remove an auth user, since
# that operation requires admin privileges no client should have.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (order confirmations, shipping updates, account
# deletion confirmation). Optional — without these, the app still works
# fine, it just silently skips sending emails (checkout and admin status
# changes never fail because of a missing email config).
# Get a free API key at https://resend.com.
# IMPORTANT: the onboarding@resend.dev sandbox sender below can ONLY
# deliver to the email address you signed up to Resend with — sending to
# any other address returns a 403 until you verify your own domain. For
# testing, sign up/checkout in the app using that same email address, or
# verify a domain in Resend and change the sender below to it.
RESEND_API_KEY=your-resend-api-key
NOTIFICATIONS_FROM_EMAIL=Aura <onboarding@resend.dev>
